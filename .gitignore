# Publish only what the live site uses. Everything else in this folder
# (catalogue PDFs, older page versions, unused images) stays local.
/*
!/.gitignore
!/README.md
!/index.html
!/atelier-bags-premium.html

!/assets/
/assets/*

!/assets/css/
/assets/css/*
!/assets/css/site.css

!/assets/js/
/assets/js/*
!/assets/js/site.js
!/assets/js/catalogue.js
!/assets/js/studio.js

!/assets/img/
/assets/img/*
!/assets/img/favicon.svg
!/assets/img/og-cover.jpg
!/assets/img/factory-bench.jpg
!/assets/img/factory-cutting.jpg
!/assets/img/factory-wide.jpg
!/assets/img/leather-thread.jpg
!/assets/img/clients/
!/assets/img/logos/
!/assets/img/products/
!/assets/img/stock/

.DS_Store
